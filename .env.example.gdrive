# Google Drive OAuth2 Configuration
# Uncomment and fill in these values after completing GOOGLE_DRIVE_SETUP.md

# Client ID dari Google Cloud Console
# GOOGLE_DRIVE_CLIENT_ID=xxx.apps.googleusercontent.com

# Client Secret dari Google Cloud Console
# GOOGLE_DRIVE_CLIENT_SECRET=xxx

# Refresh Token (dari OAuth2 flow)
# GOOGLE_DRIVE_REFRESH_TOKEN=xxx

# ID Folder di Google Drive tempat file akan disimpan
# (Copy dari URL folder: https://drive.google.com/drive/folders/FOLDER_ID)
# GOOGLE_DRIVE_FOLDER_ID=xxx
